     "id": "a32ade6",
     "elType": "widget",
     "settings": {
      "html": "<style>\n/* ===== Richard Brokaw – interactive book sample (rb-book) ===== */\n.rb-book { --paper: #FBF8F1; --paper-edge: #E9E2D2; --ink: #2B2B2B; --rule: #B8893B; --navy: #1F2A44;\n  position: relative; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 14px; }\n.rb-book .rb-src { display: none; }\n.rb-clip { width: 100%; display: flex; justify-content: center; overflow: visible; padding-block: 8px 22px; }\n.rb-book.is-narrow .rb-clip { overflow: hidden; }\n.rb-stage { position: relative; width: calc(var(--w) * 2); height: calc(var(--w) * 1.5); perspective: 2200px; max-width: 100%; }\n.rb-book.is-narrow .rb-stage { width: var(--w); }\n\n.rb-book3d { position: absolute; top: 0; left: var(--w); width: var(--w); height: 100%;\n  transform-style: preserve-3d; transition: transform .7s cubic-bezier(.3,.7,.2,1); }\n.rb-book.is-narrow .rb-book3d { left: 0; }\n.rb-book.is-closed .rb-book3d { transform: translateX(calc(var(--w) * -0.5)); }\n.rb-book.is-narrow.is-closed .rb-book3d { transform: none; }\n\n/* page block under the leaves: thickness + shadow */\n.rb-block { position: absolute; inset: 0; background: var(--paper); border-radius: 0 3px 3px 0;\n  box-shadow: 0 18px 40px -12px rgba(0,0,0,.45), inset 0 0 0 1px var(--paper-edge); }\n.rb-block::after { content: \"\"; position: absolute; top: 3px; bottom: 3px; right: -7px; width: 7px; border-radius: 0 2px 2px 0;\n  background: repeating-linear-gradient(90deg, #f3eee3 0 1px, #d9d0bd 1px 2px); box-shadow: 2px 0 4px rgba(0,0,0,.15); }\n\n.rb-leaf { position: absolute; inset: 0; transform-origin: left center; transform-style: preserve-3d;\n  transition: transform .9s cubic-bezier(.45,.05,.2,1); cursor: pointer; }\n.rb-leaf.is-flipped { transform: rotateY(-180deg); }\n.rb-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; }\n.rb-face.back { transform: rotateY(180deg); }\n.rb-face.paper { background: var(--paper); color: var(--ink); }\n.rb-face.front.paper { border-radius: 0 3px 3px 0; box-shadow: inset 14px 0 18px -14px rgba(0,0,0,.28); }\n.rb-face.back.paper { border-radius: 3px 0 0 3px; box-shadow: inset -14px 0 18px -14px rgba(0,0,0,.28); }\n.rb-face.cover { border-radius: 2px 4px 4px 2px; background: var(--navy); }\n.rb-face.cover img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.rb-face.cover::after { content: \"\"; position: absolute; inset: 0; pointer-events: none;\n  background: linear-gradient(90deg, rgba(0,0,0,.35) 0, rgba(255,255,255,.12) 3%, rgba(0,0,0,0) 7%, rgba(0,0,0,0) 94%, rgba(0,0,0,.18) 100%); }\n.rb-face.inside-cover { background: #EFE8D8; }\n\n/* hover peek: lift the cover when closed */\n@media (hover: hover) {\n  .rb-book.is-closed .rb-stage:hover .rb-leaf.is-cover { transform: rotateY(-32deg); }\n}\n.rb-book.is-closed .rb-leaf.is-cover:focus-visible { outline: 3px solid #D4AE6B; outline-offset: 4px; }\n\n/* page typography: sizes scale with the page width */\n.rb-pg { position: absolute; inset: 0; padding: calc(var(--w) * .1) calc(var(--w) * .09) calc(var(--w) * .12);\n  font: calc(var(--w) * .043)/1.6 Georgia, \"Times New Roman\", serif; display: flex; flex-direction: column; gap: .7em; }\n.rb-pg h3 { font: 700 1.5em/1.2 \"Playfair Display\", Georgia, serif; color: var(--navy); margin: 0; text-wrap: balance; }\n.rb-pg h4 { font: 700 .72em/1.3 Lato, Arial, sans-serif; letter-spacing: .2em; text-transform: uppercase; color: var(--rule); margin: 0; }\n.rb-pg p { margin: 0; }\n.rb-pg .rb-ph { border: 1px dashed #C9BFA9; padding: .8em; color: #7a7364; font-style: italic; flex: 1; display: grid; place-items: center; text-align: center; }\n.rb-pg .rb-folio { position: absolute; bottom: calc(var(--w) * .05); left: 0; right: 0; text-align: center; font-size: .75em; color: #9a9282; }\n.rb-pg.title { align-items: center; justify-content: center; text-align: center; }\n.rb-pg.title hr { width: 30%; border: 0; border-top: 1px solid var(--rule); margin: .4em 0; }\n.rb-pg.title .sub { font-style: italic; color: #5A6070; font-size: .9em; }\n.rb-pg.end { align-items: center; justify-content: center; text-align: center; }\n.rb-pg.end a { display: inline-block; margin-top: .6em; background: var(--rule); color: #fff; text-decoration: none;\n  font: 700 .72em/1 Lato, Arial, sans-serif; letter-spacing: .15em; text-transform: uppercase; padding: 1em 1.4em; border-radius: 2px; }\n\n/* controls */\n.rb-hint { font: 700 12px/1.4 Lato, Arial, sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #5A6070; text-align: center; }\n.rb-controls { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; }\n.rb-controls[hidden] { display: none !important; }\n.rb-controls button { font: 700 12px/1 Lato, Arial, sans-serif; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer;\n  background: transparent; color: var(--navy); border: 2px solid var(--navy); padding: 11px 16px; border-radius: 2px; }\n.rb-controls button:hover:not(:disabled) { background: var(--navy); color: #fff; }\n.rb-controls button:disabled { opacity: .35; cursor: default; }\n.rb-controls button:focus-visible { outline: 3px solid #D4AE6B; outline-offset: 3px; }\n.rb-count { font: 400 14px/1 Lato, Arial, sans-serif; color: #5A6070; min-width: 9em; text-align: center; font-variant-numeric: tabular-nums; }\n.rb-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n\n@media (prefers-reduced-motion: reduce) { .rb-book3d, .rb-leaf { transition: none; } }\n\n\n.bk-hero { text-align: center; }\n.bk-hero h1 { font-size: clamp(34px, 4.6vw, 50px); }\n.bk-hero blockquote { margin: 0 auto; max-width: 40ch; font: italic 400 clamp(19px, 2.2vw, 22px)/1.5 Playfair Display, Georgia, serif; color: #D9DCE3; }\n.bk-jump { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 8px; }\n.bk { padding-block: 80px 90px; }\n.bk.alt { background: #F7F3EC; }\n.bk-head { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px; margin-bottom: 26px; }\n.bk-head h2 { font-size: clamp(30px, 4vw, 42px); color: #1F2A44; }\n.bk-head .sub { font: italic 400 clamp(17px, 2vw, 20px)/1.45 Playfair Display, Georgia, serif; color: #5A6070; max-width: 46ch; }\n.bk-body { max-width: 680px; margin: 30px auto 0; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }\n.bk-body .copy { display: flex; flex-direction: column; gap: 14px; }\n.rb-buy { min-width: 260px; text-align: center; }\n.rb-buy.is-soon { background: transparent; color: #5A6070; border-color: #C9BFA9; cursor: default; }\n.rb-buy.is-soon:hover { background: transparent; border-color: #C9BFA9; }\n.rb-note { font-size: 14px; color: #5A6070; }\n.rb-note a { color: #B8893B; font-weight: 700; }\n.rb-details { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 28px; margin: 4px 0 0; font-size: 14px; color: #5A6070; }\n.rb-details div { display: flex; gap: 8px; }\n.rb-details dt { font-weight: 700; color: #1F2A44; }\n.rb-details dd { margin: 0; font-variant-numeric: tabular-nums; }\n.bk-close { text-align: center; }\n.bk-close h2 { font-size: clamp(26px, 3.4vw, 34px); color: #1F2A44; }\n\n</style>\n<script>\n/* Richard Brokaw – interactive book sample. Each .rb-book holds a cover image and a hidden list of .rb-page sections. */\n(function () {\n  function setup(root) {\n    var src = root.querySelector('.rb-src');\n    var pages = [].slice.call(src.querySelectorAll('.rb-page')).map(function (p) { return p.innerHTML; });\n    var classes = [].slice.call(src.querySelectorAll('.rb-page')).map(function (p) { return p.getAttribute('data-kind') || ''; });\n    var cover = root.getAttribute('data-cover'), alt = root.getAttribute('data-cover-alt') || '';\n    var title = root.getAttribute('data-title') || 'this book';\n\n    var clip = document.createElement('div'); clip.className = 'rb-clip';\n    var stage = document.createElement('div'); stage.className = 'rb-stage';\n    var book = document.createElement('div'); book.className = 'rb-book3d';\n    stage.appendChild(book); clip.appendChild(stage);\n    var hint = document.createElement('p'); hint.className = 'rb-hint';\n    var controls = document.createElement('div'); controls.className = 'rb-controls'; controls.hidden = true;\n    controls.innerHTML = '<button type=\"button\" data-act=\"prev\">← Previous</button><span class=\"rb-count\" aria-live=\"polite\"></span>' +\n      '<button type=\"button\" data-act=\"next\">Next →</button><button type=\"button\" data-act=\"close\">Close Book</button>';\n    root.insertBefore(controls, src); root.insertBefore(hint, controls); root.insertBefore(clip, hint);\n\n    var leaves = [], cur = 0, narrow = null, list = pages, kinds = classes;\n\n    function face(side, html, kind) {\n      var f = document.createElement('div');\n      if (kind === 'cover') { f.className = 'rb-face front cover'; f.innerHTML = '<img src=\"' + cover + '\" alt=\"' + alt.replace(/\"/g, '&quot;') + '\">'; return f; }\n      f.className = 'rb-face paper ' + side + (kind === 'blank-cover' ? ' inside-cover' : '');\n      if (html != null) f.innerHTML = '<div class=\"rb-pg ' + (kind || '') + '\">' + html + '</div>';\n      return f;\n    }\n\n    function build() {\n      book.innerHTML = '<div class=\"rb-block\"></div>';\n      leaves = [];\n      var spec = [];\n      list = pages.slice(); kinds = classes.slice();\n      // in a two-page spread the last page must land on a right-hand page\n      if (!narrow && list.length % 2) { list.splice(list.length - 1, 0, ''); kinds.splice(kinds.length - 1, 0, ''); }\n      var pages_ = list, classes_ = kinds;\n      if (!narrow) {                      // spread: cover | title, then two pages per leaf\n        spec.push([['cover'], [pages_[0], classes_[0]]]);\n        for (var i = 1; i < pages_.length; i += 2) spec.push([[pages_[i], classes_[i]], i + 1 < pages_.length ? [pages_[i + 1], classes_[i + 1]] : [null, '']]);\n      } else {                            // single page: every page on a front face\n        spec.push([['cover'], [null, 'blank-cover']]);\n        for (var j = 0; j < pages_.length; j++) spec.push([[pages_[j], classes_[j]], [null, '']]);\n      }\n      spec.forEach(function (s, idx) {\n        var leaf = document.createElement('div'); leaf.className = 'rb-leaf';\n        var front = s[0][0] === 'cover' ? face('front', null, 'cover') : face('front', s[0][0], s[0][1]);\n        var back = face('back', s[1][0], s[1][1]);\n        leaf.appendChild(front); leaf.appendChild(back);\n        leaf.addEventListener('click', function () { if (leaf.classList.contains('is-flipped')) go(cur - 1); else go(cur + 1); });\n        if (idx === 0) { leaf.classList.add('is-cover'); leaf.tabIndex = 0; leaf.setAttribute('role', 'button'); leaf.setAttribute('aria-label', 'Open a sample of ' + title); }\n        book.appendChild(leaf); leaves.push(leaf);\n      });\n      render(); z();\n    }\n\n    function z() {\n      var n = leaves.length;\n      leaves.forEach(function (l, i) { l.style.zIndex = l.classList.contains('is-flipped') ? i + 1 : n - i + 1; });\n    }\n\n    function render() {\n      var max = leaves.length - 1, total = list.length;\n      leaves.forEach(function (l, i) {\n        var flipped = i < cur; l.classList.toggle('is-flipped', flipped);\n        // only the two faces in view are exposed to screen readers\n        var visible = narrow ? (i === cur) : (i === cur || i === cur - 1);\n        l.setAttribute('aria-hidden', cur === 0 ? (i === 0 ? 'false' : 'true') : (visible ? 'false' : 'true'));\n      });\n      root.classList.toggle('is-closed', cur === 0);\n      leaves[0].tabIndex = cur === 0 ? 0 : -1;\n      hint.hidden = cur !== 0;\n      hint.textContent = (window.matchMedia('(hover: hover)').matches ? 'Click' : 'Tap') + ' the book to read a sample';\n      controls.hidden = cur === 0;\n      var prev = controls.querySelector('[data-act=prev]'), next = controls.querySelector('[data-act=next]');\n      var had = document.activeElement;\n      prev.disabled = cur <= 1; next.disabled = cur >= max;\n      // keep keyboard focus inside the reader when a button turns off\n      if (had === next && next.disabled) prev.focus(); else if (had === prev && prev.disabled) next.focus();\n      var label;\n      if (narrow) label = 'Page ' + cur + ' of ' + total;\n      else { var a = 2 * cur - 1, b = Math.min(2 * cur, total); label = (a === b ? 'Page ' + a : 'Pages ' + a + '–' + b) + ' of ' + total; }\n      controls.querySelector('.rb-count').textContent = label;\n    }\n\n    function go(to) {\n      var max = leaves.length - 1;\n      to = Math.max(0, Math.min(max, to));\n      if (to === cur) return;\n      var n = leaves.length;\n      // leaves that change side ride on top while they turn\n      if (to > cur) for (var i = cur; i < to; i++) leaves[i].style.zIndex = n + 10 + i;\n      else for (var j = cur - 1; j >= to; j--) leaves[j].style.zIndex = n + 10 + (n - j);\n      cur = to;\n      render();\n      clearTimeout(go.t); go.t = setTimeout(z, 950);\n    }\n\n    controls.addEventListener('click', function (e) {\n      var a = e.target.getAttribute('data-act');\n      if (a === 'prev') go(cur - 1);\n      else if (a === 'next') go(cur + 1);\n      else if (a === 'close') { go(0); leaves[0].focus({ preventScroll: true }); }\n    });\n    root.addEventListener('keydown', function (e) {\n      if (e.key === 'ArrowRight') { go(cur + 1); e.preventDefault(); }\n      else if (e.key === 'ArrowLeft') { go(cur - 1); e.preventDefault(); }\n      else if ((e.key === 'Enter' || e.key === ' ') && e.target === leaves[0] && cur === 0) { go(1); e.preventDefault(); }\n      else if (e.key === 'Escape' && cur > 0) go(0);\n    });\n    var sx = null;\n    stage.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });\n    stage.addEventListener('touchend', function (e) {\n      if (sx == null || cur === 0) return; var dx = e.changedTouches[0].clientX - sx; sx = null;\n      if (Math.abs(dx) > 40) go(cur + (dx < 0 ? 1 : -1));\n    });\n\n    function size() {\n      var avail = root.clientWidth;\n      var nowNarrow = avail < 560;\n      var w = nowNarrow ? Math.min(avail - 16, 360) : Math.min(Math.floor((avail - 24) / 2), 340);\n      root.style.setProperty('--w', w + 'px');\n      root.classList.toggle('is-narrow', nowNarrow);\n      if (nowNarrow !== narrow) {\n        var wasOpen = cur > 0; narrow = nowNarrow; cur = 0; build();\n        if (wasOpen) go(1);\n      }\n    }\n    size();\n    if ('ResizeObserver' in window) new ResizeObserver(size).observe(root); else window.addEventListener('resize', size);\n  }\n  function init() { [].forEach.call(document.querySelectorAll('.rb-book:not([data-ready])'), function (b) { b.setAttribute('data-ready', '1'); setup(b); }); }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();\n  window.rbBookInit = init;\n})();\n\n</script>"
